<Window x:Class="KidGuard.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="KidGuard"
        Height="720"
        Width="1080"
        MinHeight="520"
        MinWidth="760"
        Background="{StaticResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <TextBox x:Name="ApiBaseUrlTextBox" Visibility="Collapsed" />
        <TextBox x:Name="ChildApiBaseUrlTextBox" Visibility="Collapsed" />
        <PasswordBox x:Name="ChildSetupTokenPasswordBox" Visibility="Collapsed" />

        <Grid x:Name="RoleSelectionPanel">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        MaxWidth="700"
                        MinWidth="560">
                <TextBlock Text="Choose how this Windows device will use KidGuard"
                           FontSize="30"
                           FontWeight="Bold"
                           TextAlignment="Left" />
                <TextBlock Text="Parent manages approved child devices. Child shows a connection code and approves pairing before protection starts."
                           Margin="0,14,0,28"
                           FontSize="15"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap" />
                <UniformGrid Columns="2">
                    <Button Content="Parent Mode"
                            Height="96"
                            Margin="0,0,10,0"
                            FontSize="17"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="ParentModeButton_Click" />
                    <Button Content="Child Mode"
                            Height="96"
                            Margin="10,0,0,0"
                            FontSize="17"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="ChildModeButton_Click" />
                </UniformGrid>
            </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="ParentPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,24">
                <Button Content="Back"
                        DockPanel.Dock="Right"
                        Width="92"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BackButton_Click" />
                <StackPanel>
                    <TextBlock Text="Parent Mode" FontSize="28" FontWeight="Bold" />
                    <TextBlock Text="Login or register before opening the parent dashboard."
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <ScrollViewer x:Name="ParentAuthPanel"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <Grid MinWidth="430">
                <Border Width="430"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,12,0,24"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="30">
                    <StackPanel>
                        <TextBlock Text="Welcome back"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   TextAlignment="Center" />
                        <TextBlock Text="Sign in or create a parent account to continue."
                                   Margin="0,8,0,22"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextAlignment="Center" />

                        <Border Background="#F3F4F6"
                                CornerRadius="8"
                                Padding="4"
                                Margin="0,0,0,24">
                            <UniformGrid Columns="2">
                                <Button x:Name="LoginTabButton"
                                        Content="Login"
                                        Height="42"
                                        Margin="0,0,4,0"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="LoginTabButton_Click" />
                                <Button x:Name="RegisterTabButton"
                                        Content="Register"
                                        Height="42"
                                        Margin="4,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="RegisterTabButton_Click" />
                            </UniformGrid>
                        </Border>

                        <StackPanel x:Name="LoginFormPanel">
                            <TextBlock Text="Username or Gmail" />
                            <TextBox x:Name="ParentEmailTextBox" />
                            <TextBlock Text="Password" />
                            <PasswordBox x:Name="ParentPasswordBox" />
                            <Button x:Name="ParentLoginButton"
                                    Content="Login"
                                    Height="44"
                                    Margin="0,8,0,0"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="ParentLoginButton_Click" />
                        </StackPanel>

                        <StackPanel x:Name="RegisterFormPanel" Visibility="Collapsed">
                            <TextBlock Text="Username" />
                            <TextBox x:Name="ParentFullNameTextBox" />
                            <TextBlock Text="Gmail" />
                            <TextBox x:Name="ParentRegisterEmailTextBox" />
                            <TextBlock Text="Password" />
                            <PasswordBox x:Name="ParentRegisterPasswordBox" />
                            <TextBlock Text="Confirm password" />
                            <PasswordBox x:Name="ParentRegisterConfirmPasswordBox" />
                            <TextBlock Text="Phone number" />
                            <TextBox x:Name="ParentPhoneNumberTextBox" />
                            <Button x:Name="ParentRegisterButton"
                                    Content="Create account"
                                    Height="44"
                                    Margin="0,8,0,0"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="ParentRegisterButton_Click" />
                        </StackPanel>

                        <TextBlock x:Name="ParentLoginStatusTextBlock"
                                   Text="Backend: http://127.0.0.1:5133"
                                   Margin="0,16,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center" />
                    </StackPanel>
                </Border>
                </Grid>
            </ScrollViewer>

            <ScrollViewer x:Name="ParentDashboardPanel"
                          Grid.Row="1"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <Grid MinWidth="860">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.95*" />
                        <ColumnDefinition Width="1.05*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{StaticResource PanelBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="24"
                            Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Pairing" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="Child connection code" Margin="0,18,0,0" />
                            <TextBox x:Name="ChildCodeTextBox" CharacterCasing="Upper" MaxLength="12" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="SendPairRequestButton"
                                        Content="Send Request"
                                        Width="140"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="SendPairRequestButton_Click" />
                                <Button x:Name="RefreshPairingStatusButton"
                                        Content="Refresh Status"
                                        Width="140"
                                        Margin="10,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="RefreshPairingStatusButton_Click" />
                            </StackPanel>
                            <Border Background="#F9FAFB"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14"
                                    Margin="0,22,0,0">
                                <StackPanel>
                                    <TextBlock Text="Pairing status" FontWeight="SemiBold" />
                                    <Border x:Name="PairingStateBadge"
                                            Background="#EEF2FF"
                                            BorderBrush="#C7D2FE"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10,6"
                                            Margin="0,8,0,10"
                                            HorizontalAlignment="Left">
                                        <TextBlock x:Name="PairingStateTextBlock"
                                                   Text="Not started"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1E3A8A" />
                                    </Border>
                                    <TextBlock x:Name="PairingStatusTextBlock"
                                               Text="Enter a child code to send a request."
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap" />
                                    <Border x:Name="PairedDevicePanel"
                                            Background="#FFFFFF"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12"
                                            Margin="0,12,0,0"
                                            Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock Text="Paired device" FontWeight="SemiBold" />
                                            <TextBlock x:Name="PairedDeviceNameTextBlock" Margin="0,6,0,0" />
                                            <TextBlock x:Name="PairedDeviceIdTextBlock"
                                                       Margin="0,4,0,0"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock x:Name="PairedDeviceModeTextBlock"
                                                       Margin="0,4,0,0"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <TextBox x:Name="DeviceTokenTextBox"
                                             Margin="0,12,0,0"
                                             MinHeight="72"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             IsReadOnly="True"
                                             Visibility="Collapsed" />
                                    <Button x:Name="CopyDeviceTokenButton"
                                            Content="Copy Token"
                                            Width="116"
                                            Margin="0,10,0,0"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Visibility="Collapsed"
                                            Click="CopyDeviceTokenButton_Click" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Background="{StaticResource PanelBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="24"
                            Margin="12,0,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Button x:Name="RefreshDevicesButton"
                                        Content="Refresh"
                                        DockPanel.Dock="Right"
                                        Width="96"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="RefreshDevicesButton_Click" />
                                <TextBlock Text="Approved devices"
                                           VerticalAlignment="Center"
                                           FontSize="20"
                                           FontWeight="SemiBold" />
                            </DockPanel>
                            <ListBox x:Name="DeviceListBox"
                                     MinHeight="120"
                                     DisplayMemberPath="DisplayText"
                                     SelectionChanged="DeviceListBox_SelectionChanged" />
                            <TextBlock x:Name="DeviceListStatusTextBlock"
                                       Text="No devices loaded."
                                       Margin="0,12,0,0"
                                       Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="Mode control"
                                       Margin="0,18,0,0"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="DeviceModeComboBox"
                                          Width="150"
                                          IsEnabled="False">
                                    <ComboBoxItem Content="fun" />
                                    <ComboBoxItem Content="study" />
                                    <ComboBoxItem Content="punishment" />
                                </ComboBox>
                                <Button x:Name="UpdateModeButton"
                                        Content="Update Mode"
                                        Width="126"
                                        Margin="10,0,0,0"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        IsEnabled="False"
                                        Click="UpdateModeButton_Click" />
                            </StackPanel>
                            <TextBlock x:Name="ModeStatusTextBlock"
                                       Text="Select an approved device to change mode."
                                       Margin="0,8,0,0"
                                       Foreground="{StaticResource MutedTextBrush}" />
                            <DockPanel Margin="0,18,0,10">
                                <Button x:Name="RefreshLogsButton"
                                        Content="Refresh Logs"
                                        DockPanel.Dock="Right"
                                        Width="116"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        IsEnabled="False"
                                        Click="RefreshLogsButton_Click" />
                                <TextBlock Text="Recent logs"
                                           VerticalAlignment="Center"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                            </DockPanel>
                            <ListBox x:Name="DeviceLogsListBox"
                                     MinHeight="100"
                                     DisplayMemberPath="DisplayText" />
                            <TextBlock x:Name="LogsStatusTextBlock"
                                       Text="Select a device to load logs."
                                       Margin="0,8,0,0"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="ChildPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,24">
                <Button Content="Back"
                        DockPanel.Dock="Right"
                        Width="92"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BackButton_Click" />
                <StackPanel>
                    <TextBlock Text="Child Mode" FontSize="28" FontWeight="Bold" />
                    <TextBlock Text="Create a connection code, then approve or reject the parent request."
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <Grid MinWidth="620">
                    <Border Width="560"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="0,12,0,24"
                            Background="{StaticResource PanelBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="30">
                        <StackPanel>
                            <TextBlock Text="Child connection"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       TextAlignment="Center" />
                            <TextBlock Text="Create a code, wait for the parent request, then approve or reject it."
                                       Margin="0,8,0,24"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextAlignment="Center" />

                            <TextBlock Text="Device name" />
                            <TextBox x:Name="ChildDeviceNameTextBox" />

                            <Border Background="#EFF6FF"
                                    BorderBrush="#BFDBFE"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="18"
                                    Margin="0,10,0,16">
                                <StackPanel>
                                    <TextBlock Text="Connection code"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextAlignment="Center" />
                                    <TextBlock x:Name="ConnectionCodeTextBlock"
                                               Text="WAITING"
                                               FontSize="34"
                                               FontWeight="Bold"
                                               TextAlignment="Center"
                                               Foreground="#1D4ED8" />
                                </StackPanel>
                            </Border>

                            <Button x:Name="CreateCodeButton"
                                    Content="Create Code"
                                    Height="44"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="CreateCodeButton_Click" />
                            <TextBlock x:Name="ChildCodeStatusTextBlock"
                                       Text="Create a code before pairing."
                                       Margin="0,14,0,22"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />

                            <Button x:Name="CheckPendingRequestButton"
                                    Content="Check parent request"
                                    Height="42"
                                    Margin="0,0,0,16"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Visibility="Collapsed"
                                    Click="CheckPendingRequestButton_Click" />

                            <Border x:Name="PendingRequestPanel"
                                    Background="#F9FAFB"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16"
                                    Margin="0,0,0,16"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="Pending request"
                                               FontSize="18"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="PendingRequestTextBlock"
                                               Text="No parent request yet."
                                               Margin="0,8,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="Grant permission allows the KidGuard Agent service to protect this computer with administrator-level service permissions. Deny will reject pairing with this parent."
                                               Margin="0,12,0,0"
                                               Foreground="#B45309"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Grid x:Name="ChildDecisionPanel" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ApprovePairingButton"
                                        Content="Grant permission"
                                        Height="42"
                                        Margin="0,0,6,0"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        IsEnabled="False"
                                        Click="ApprovePairingButton_Click" />
                                <Button x:Name="RejectPairingButton"
                                        Grid.Column="1"
                                        Content="Deny"
                                        Height="42"
                                        Margin="6,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        IsEnabled="False"
                                        Click="RejectPairingButton_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
